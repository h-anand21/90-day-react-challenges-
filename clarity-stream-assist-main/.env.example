# =============================================================================
# AccessAI — Environment Variables Reference
# =============================================================================
# This file documents every environment variable the app reads.
# Copy to `.env.local` and fill in values for local development.
# NEVER commit real secrets. `.env.local` is git-ignored (see `*.local` rule).
#
# On Lovable Cloud, secrets are stored in the encrypted backend vault
# (Backend → Secrets), NOT in this file. They are injected as `process.env.*`
# at runtime for server functions and API routes.
# =============================================================================


# -----------------------------------------------------------------------------
# Lovable Cloud (auto-provisioned — do not set manually)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=your-project-id


# -----------------------------------------------------------------------------
# Lovable AI Gateway (server-only)
# Powers chat, translation, summarization, and Whisper transcription fallback.
# Auto-provisioned on Lovable Cloud.
# -----------------------------------------------------------------------------
LOVABLE_API_KEY=


# -----------------------------------------------------------------------------
# Provider Selection (server-only)
# Choose which provider handles each AI capability. The factory falls back
# through the chain automatically if the primary fails.
#
# Values: deepgram | whisper | assemblyai | google | groq   (transcription)
# Values: gemini | openai                                    (text / chat)
# -----------------------------------------------------------------------------
TRANSCRIPTION_PROVIDER=deepgram
TRANSLATION_PROVIDER=gemini
SUMMARY_PROVIDER=gemini
CHAT_PROVIDER=gemini


# -----------------------------------------------------------------------------
# Speech-to-Text Providers (server-only)
# Set only the providers you actually use.
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=                # https://console.deepgram.com/
ASSEMBLYAI_API_KEY=              # https://www.assemblyai.com/app
GOOGLE_STT_API_KEY=              # Google Cloud Speech-to-Text
GROQ_API_KEY=                    # https://console.groq.com/keys


# -----------------------------------------------------------------------------
# Text / Chat Providers (server-only)
# Optional — Lovable AI Gateway already covers Gemini + OpenAI models.
# Only set these to bypass the gateway with your own keys.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=                  # https://platform.openai.com/api-keys
GEMINI_API_KEY=                  # https://aistudio.google.com/apikey


# -----------------------------------------------------------------------------
# Third-Party Integrations (server-only)
# -----------------------------------------------------------------------------
FIREFLIES_API_KEY=               # https://app.fireflies.ai/integrations/custom/fireflies


# -----------------------------------------------------------------------------
# Modular AI pipeline stages (server-only)
# Each stage has an independent primary provider + failover chain, so a
# provider outage never restarts the session.
# -----------------------------------------------------------------------------
# Audio processing (mic cleanup, VAD)   values: webrtc | passthrough
AUDIO_PROCESSING_PROVIDER=webrtc
AUDIO_PROCESSING_FALLBACKS=passthrough

# Standalone language detection         values: deepgram | gemini
LANGUAGE_DETECTION_PROVIDER=deepgram
LANGUAGE_DETECTION_FALLBACKS=gemini

# Semantic interpretation (meaning-preserving translation)  values: gemini | openai
INTERPRETATION_PROVIDER=gemini
INTERPRETATION_FALLBACKS=openai

# Speech synthesis (TTS)                values: webspeech | openai | elevenlabs
SYNTHESIS_PROVIDER=webspeech
SYNTHESIS_FALLBACKS=openai,elevenlabs

# Interpretation validation             values: heuristic | llm | off
VALIDATION_MODE=heuristic

# Audience adaptation default profile
# values: general | student_school | student_university | professional | researcher | accessibility
AUDIENCE_DEFAULT=general

# ElevenLabs (optional TTS)
ELEVENLABS_API_KEY=
