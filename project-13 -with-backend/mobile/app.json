{
  "expo": {
    "name": "TripSync",
    "slug": "tripsync-mobile",
    "version": "1.0.0",
    "newArchEnabled": true,

    "icon": "./assets/icon.png",

    "orientation": "portrait",
    "userInterfaceStyle": "dark",

    "assetBundlePatterns": ["**/*"],

    "splash": {
      "image": "./assets/image copy.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tripsync.app"
    },

    "android": {
      "package": "com.tripsync.app",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",

      "adaptiveIcon": {
        "foregroundImage": "./assets/image.png",
        "backgroundColor": "#000000"
      }
    },

    "extra": {
      "apiUrl": "https://tripsync-backend-9mle.onrender.com/api"
    }
  }
}
